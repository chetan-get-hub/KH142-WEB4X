# ============================================================
# DataCleaning4U - Environment Configuration
# ============================================================

# 1. Google Gemini API Configuration (FREE TIER ONLY)
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_FREE_ONLY=true
GEMINI_MODEL=gemini-2.5-flash

# 2. PostgreSQL Database Connection (SQLAlchemy + Psycopg 3)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/datacleaning4u

# 3. Backend Service Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
APP_ENV=development
